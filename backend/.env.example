# 复制为环境变量使用（Linux: export；Windows: set）
# 运行环境：production（默认，最严格：拒绝默认密码/演示数据/通配跨域/自动建表）；演示用 demo
APP_ENV=production
CORS_ORIGINS=https://你的访问域名
DATABASE_URL=mysql+pymysql://prodsync:密码@127.0.0.1:3306/prodsync?charset=utf8mb4
SECRET_KEY=请用 openssl rand -hex 32 生成（至少 32 位）
AUTO_CREATE_TABLES=0
UPLOAD_DIR=D:/prodsync/uploads
KIT_BUFFER_DAYS=2
STAGNANT_DAYS=180
# 自动重算齐套并生成缺料、D-2、库存、异常与逾期预警的间隔（分钟；0=关闭）
ALERT_SCAN_MINUTES=5
# AI（可选，默认关闭；也可在系统设置界面里配置）
AI_ENABLED=0
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
